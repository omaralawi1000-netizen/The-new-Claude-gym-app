<?xml version="1.0" encoding="utf-8"?>
<!-- The rest's bar: a slim rounded ember line on a faint ember track; the line keeps its round ends as it drains. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="@color/ember_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleGravity="left" android:scaleWidth="100%">
            <shape>
                <corners android:radius="3dp" />
                <solid android:color="@color/ember" />
            </shape>
        </scale>
    </item>
</layer-list>
