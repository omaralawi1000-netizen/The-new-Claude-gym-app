<?xml version="1.0" encoding="utf-8"?>
<!-- The rest countdown, unfolded: the time left in big numbers, the set under it, a bar draining as the rest runs, and
     +30 s / Skip as two even ember pills (ours, so they're Aven's colour and size, not the phone's thin blue words). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/clock"
        style="@android:style/TextAppearance.Material.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textSize="44sp" />

    <Chronometer
        android:id="@+id/chrono"
        style="@android:style/TextAppearance.Material.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textSize="44sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/line"
        style="@android:style/TextAppearance.Material.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:singleLine="true" />

    <ProgressBar
        android:id="@+id/bar"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="12dp"
        android:maxHeight="5dp"
        android:minHeight="5dp"
        android:progressDrawable="@drawable/rest_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/more"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/rest_button"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/ember_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/skip"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/rest_button"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/ember_text"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
