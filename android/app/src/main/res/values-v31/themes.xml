<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch screen: the icon opens into ink with the orb in the middle, the same 100 dp orb Chrome's
         hand-off screen shows next, so it stays put from the tap until the app is drawn. -->
    <style name="Theme.Aven" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowSplashScreenBackground">@color/ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
